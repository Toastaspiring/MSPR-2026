{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "mecha-demo-live",
  "title": "MECHA — DEMO Live (DBSCAN temps réel)",
  "description": "Flux temps réel alimenté par le service demo. Détection d'anomalies DBSCAN non supervisée : chaque point est associé à un cluster ; cluster_label = -1 identifie un comportement inhabituel (point de bruit), sans quantifier de probabilité de panne.",
  "tags": [
    "mecha",
    "demo",
    "live",
    "anomalies",
    "dbscan"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "machine_id",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "MECHA-Postgres"
        },
        "query": "SELECT DISTINCT machine_id FROM sensor_data ORDER BY machine_id;",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Anomalies levées (15 min)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "MECHA-Postgres"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "valueSize": 36,
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value FROM predictions WHERE anomaly = TRUE AND recorded_at > NOW() - INTERVAL '15 minutes';",
          "format": "table"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Machines en anomalie",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "MECHA-Postgres"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "valueSize": 36,
          "titleSize": 14
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value FROM v_last_prediction_per_machine WHERE anomaly = TRUE;",
          "format": "table"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Score d'anomalie max (live)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "MECHA-Postgres"
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "valueSize": 36,
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "rawSql": "SELECT recorded_at AS time, MAX(anomaly_score) AS value FROM predictions WHERE recorded_at > NOW() - INTERVAL '15 minutes' GROUP BY recorded_at ORDER BY recorded_at;",
          "format": "time_series"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Taux de bruit DBSCAN (15 min)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "MECHA-Postgres"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "valueSize": 36,
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT COALESCE(SUM(CASE WHEN cluster_label = -1 THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*), 0), 0) AS value FROM predictions WHERE recorded_at > NOW() - INTERVAL '15 minutes';",
          "format": "table"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Température (°C) — flux live",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "MECHA-Postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never"
          },
          "unit": "celsius"
        }
      },
      "targets": [
        {
          "rawSql": "SELECT \"timestamp\" AS time, machine_id::text AS metric, \"temperature_C\" AS value FROM sensor_data WHERE machine_id IN ($machine_id) AND $__timeFilter(\"timestamp\") ORDER BY \"timestamp\";",
          "format": "time_series"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Vibration — flux live",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "MECHA-Postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT \"timestamp\" AS time, machine_id::text AS metric, vibration AS value FROM sensor_data WHERE machine_id IN ($machine_id) AND $__timeFilter(\"timestamp\") ORDER BY \"timestamp\";",
          "format": "time_series"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Score d'anomalie (live) — par machine",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "postgres",
        "uid": "MECHA-Postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawSql": "SELECT recorded_at AS time, machine_id::text AS metric, anomaly_score AS value FROM predictions WHERE machine_id IN ($machine_id) AND $__timeFilter(recorded_at) ORDER BY recorded_at;",
          "format": "time_series"
        }
      ]
    },
    {
      "type": "table",
      "title": "Flux d'anomalies (live)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "postgres",
        "uid": "MECHA-Postgres"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alert_level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "nominal": {
                        "color": "green"
                      },
                      "warning": {
                        "color": "orange"
                      },
                      "critical": {
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cluster"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "color": "red",
                        "text": "-1 (bruit)"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT recorded_at AS \"horodatage\", machine_id AS \"machine\", cluster_label AS \"cluster\", anomaly_score AS \"score\", alert_level FROM predictions WHERE anomaly = TRUE AND recorded_at > NOW() - INTERVAL '15 minutes' ORDER BY recorded_at DESC LIMIT 50;",
          "format": "table"
        }
      ]
    }
  ]
}